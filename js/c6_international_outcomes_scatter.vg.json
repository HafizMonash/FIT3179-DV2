{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Employment Rate vs. Median Starting Salary by Country of Origin (2025)",
    "subtitle": "Undergraduate international alumni outcomes 4 months post-graduation; dashed lines show cohort medians",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "color": "#1e293b",
    "subtitleColor": "#64748b"
  },
  "width": 640,
  "height": 420,
  "data": {
    "url": "data/international_graduate_outcomes_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Full_time_employment": "number",
        "Overall_employment": "number",
        "Labour_force_participation": "number",
        "Salary": "number",
        "Under_30": "number"
      }
    }
  },
  "layer": [
    {
      "description": "Horizontal median salary reference line ($70,000)",
      "data": {"values": [{"Salary": 70000}]},
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "stroke": "#94a3b8",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {"field": "Salary", "type": "quantitative"}
      }
    },
    {
      "description": "Vertical median employment reference line (52%)",
      "data": {"values": [{"Full_time_employment": 52.0}]},
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "stroke": "#94a3b8",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "Full_time_employment", "type": "quantitative"}
      }
    },
    {
      "description": "Quadrant annotation: High Salary, High Employment",
      "data": {"values": [{"x": 62, "y": 74500, "text": ""}]},
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontStyle": "italic",
        "fill": "#64748b"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 180,
        "cursor": "pointer"
      },
      "params": [
        {
          "name": "hover_country",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout",
            "fields": ["Country"]
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "Full_time_employment",
          "type": "quantitative",
          "title": "Full-Time Employment Rate (%)",
          "scale": {"domain": [35, 68]},
          "axis": {
            "format": ".0f",
            "grid": true,
            "gridColor": "#f1f5f9",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "Salary",
          "type": "quantitative",
          "title": "Median Full-Time Annual Salary ($AUD)",
          "scale": {"domain": [60000, 76000]},
          "axis": {
            "format": "$,d",
            "grid": true,
            "gridColor": "#f1f5f9",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "opacity": {
          "condition": {
            "param": "hover_country",
            "empty": false,
            "value": 1.0
          },
          "value": 0.8
        },
        "stroke": {
          "condition": {
            "param": "hover_country",
            "empty": false,
            "value": "#0f172a"
          },
          "value": "#1e40af"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover_country",
            "empty": false,
            "value": 2.2
          },
          "value": 1.2
        },
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Home Country"},
          {"field": "Full_time_employment", "type": "quantitative", "title": "Full-Time Employment Rate", "format": ".1f"},
          {"field": "Salary", "type": "quantitative", "title": "Median Starting Salary", "format": "$,d"},
          {"field": "Overall_employment", "type": "quantitative", "title": "Overall Employment Rate", "format": ".1f"},
          {"field": "Labour_force_participation", "type": "quantitative", "title": "Labour Force Participation", "format": ".1f"},
          {"field": "Under_30", "type": "quantitative", "title": "Aged ≤ 30 Years (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": 8,
        "dy": -6,
        "fontSize": 11,
        "fontWeight": 600,
        "fill": "#1e293b"
      },
      "encoding": {
        "x": {"field": "Full_time_employment", "type": "quantitative"},
        "y": {"field": "Salary", "type": "quantitative"},
        "text": {"field": "Country", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  }
}
