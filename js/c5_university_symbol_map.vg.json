{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Graduate Salaries & Employment Across Australian Universities (2023–2025)",
    "subtitle": "Circle size reflects median starting salary ($AUD); color indicates full-time employment rate (%). Select a focus area to inspect metro clusters.",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "color": "#1e293b",
    "subtitleColor": "#64748b"
  },
  "width": 780,
  "height": 520,
  "params": [
    {
      "name": "focus_region",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Sydney", "Melbourne", "Brisbane", "Perth", "Adelaide", "ACT"],
        "labels": [
          "Whole Australia",
          "Sydney Metro",
          "Melbourne Metro",
          "Brisbane and Gold Coast",
          "Perth Metro",
          "Adelaide Metro",
          "Canberra / ACT"
        ],
        "name": "Focus Area: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": {
      "expr": "focus_region === 'Sydney' ? [151.15, -33.85] : focus_region === 'Melbourne' ? [145.02, -37.82] : focus_region === 'Brisbane' ? [153.15, -27.65] : focus_region === 'Perth' ? [115.82, -31.95] : focus_region === 'Adelaide' ? [138.60, -34.95] : focus_region === 'ACT' ? [149.10, -35.26] : [133.5, -28.0]"
    },
    "scale": {
      "expr": "focus_region === 'Sydney' ? 7000 * 1.8 : focus_region === 'Melbourne' ? 7500 * 2.5 : focus_region === 'Brisbane' ? 5000 * 2.2 : focus_region === 'Perth' ? 6500 * 2.2 : focus_region === 'Adelaide' ? 7500 * 8.0 : focus_region === 'ACT' ? 7500 * 4.5 : 850 * 1.0"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.9
      }
    },
    {
      "data": {
        "url": "data/university_employment_salaries.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Full_time_employment": "number",
            "Overall_employment": "number",
            "Labour_force_participation": "number",
            "Salary": "number",
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {"filter": "isValid(datum.Salary) && isValid(datum.Full_time_employment)"}
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "stroke": "#ffffff",
            "strokeWidth": 1.2,
            "cursor": "pointer"
          },
          "params": [
            {
              "name": "hover_uni",
              "select": {
                "type": "point",
                "on": "pointerover",
                "clear": "pointerout",
                "fields": ["Institution"]
              }
            }
          ],
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "size": {
              "field": "Salary",
              "type": "quantitative",
              "scale": {
                "domain": [60000, 76000],
                "range": [80, 500]
              },
              "legend": {
                "title": "Median Salary ($AUD)",
                "orient": "bottom-left",
                "format": "$,d",
                "offset": 8
              }
            },
            "color": {
              "field": "Full_time_employment",
              "type": "quantitative",
              "scale": {
                "scheme": "viridis",
                "domain": [40, 72]
              },
              "legend": {
                "title": "Full-Time Employed (%)",
                "orient": "bottom-right",
                "format": ".0f",
                "offset": 8
              }
            },
            "opacity": {
              "condition": {
                "param": "hover_uni",
                "empty": false,
                "value": 1.0
              },
              "value": 0.75
            },
            "stroke": {
              "condition": {
                "param": "hover_uni",
                "empty": false,
                "value": "#0f172a"
              },
              "value": "#ffffff"
            },
            "strokeWidth": {
              "condition": {
                "param": "hover_uni",
                "empty": false,
                "value": 2.2
              },
              "value": 1.2
            },
            "tooltip": [
              {"field": "Institution", "type": "nominal", "title": "University"},
              {"field": "State", "type": "nominal", "title": "State/Territory"},
              {"field": "Salary", "type": "quantitative", "title": "Median Salary", "format": "$,d"},
              {"field": "Full_time_employment", "type": "quantitative", "title": "Full-Time Employment", "format": ".1f"},
              {"field": "Overall_employment", "type": "quantitative", "title": "Overall Employment", "format": ".1f"},
              {"field": "Labour_force_participation", "type": "quantitative", "title": "Labour Force Participation", "format": ".1f"}
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "focus_region !== 'All' ? true : datum.Salary >= 74000"
            }
          ],
          "mark": {
            "type": "text",
            "dx": 12,
            "dy": -10,
            "fontSize": 10.5,
            "fontWeight": "bold",
            "fill": "#0f172a"
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"}
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  }
}
