{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 380,
  "data": {
    "url": "data/employment_by_study_level.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "selected_level",
      "value": "Undergraduate",
      "bind": {
        "input": "radio",
        "options": [
          "Undergraduate",
          "Postgraduate Coursework",
          "Postgraduate Research"
        ],
        "name": "Cohort Level: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.study_level === selected_level"},
    {
      "calculate": "datum.in_aus + (datum.overseas - datum.in_aus) / 2",
      "as": "midpoint"
    },
    {
      "calculate": "(datum.gap >= 0 ? '+' : '') + format(datum.gap, '.1f') + '% gap'",
      "as": "gap_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "sort": "descending",
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelFontWeight": "bold"
      }
    }
  },
  "layer": [
    {
      "description": "Connecting line segment between In Australia and Overseas",
      "mark": {
        "type": "rule",
        "color": "#C7D8D1",
        "strokeWidth": 4,
        "strokeCap": "round"
      },
      "encoding": {
        "x": {
          "field": "in_aus",
          "type": "quantitative",
          "title": "Proportion Employed Full-Time (%)",
          "scale": {"domain": [30, 95]},
          "axis": {"grid": true, "gridColor": "#f1f5f9", "format": ".0f"}
        },
        "x2": {"field": "overseas"}
      }
    },
    {
      "description": "Points with native color legend",
      "transform": [
        {
          "fold": ["in_aus", "overseas"],
          "as": ["location_key", "rate"]
        },
        {
          "calculate": "datum.location_key === 'in_aus' ? 'In Australia' : 'Overseas'",
          "as": "Location"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 130,
        "opacity": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "rate",
          "type": "quantitative"
        },
        "color": {
          "field": "Location",
          "type": "nominal",
          "scale": {
            "domain": ["In Australia", "Overseas"],
            "range": ["#D98C62", "#367C78"]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "labelFontSize": 12,
            "labelFontWeight": 500,
            "symbolSize": 110,
            "offset": 8
          }
        },
        "tooltip": [
          {"field": "study_level", "title": "Study Level"},
          {"field": "year", "title": "Survey Year"},
          {"field": "in_aus", "title": "In Australia (%)", "format": ".1f"},
          {"field": "overseas", "title": "Overseas (%)", "format": ".1f"},
          {"field": "gap", "title": "Overseas Advantage (% pts)", "format": ".1f"}
        ]
      }
    },
    {
      "description": "Dynamic Gap Annotation for the 2025 cohort",
      "transform": [{"filter": "datum.year === '2025'"}],
      "mark": {
        "type": "text",
        "dy": -13,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#367C78"
      }
    },
    {
      "description": "Dynamic Gap Annotation for the 2018 cohort (if present)",
      "transform": [{"filter": "datum.year === '2018'"}],
      "mark": {
        "type": "text",
        "dy": -13,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#367C78"
      },
      "encoding": {
        "x": {"field": "midpoint", "type": "quantitative"},
        "text": {"field": "gap_label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  }
}
