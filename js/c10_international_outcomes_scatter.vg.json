{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 420,
  "data": {
    "url": "data/international_graduate_outcomes_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Full_time_employment": "number",
        "Overall_employment": "number",
        "Labour_force_participation": "number",
        "Salary": "number",
        "Under_30": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "test(/Hong Kong/i, datum.Country) ? 'hk' : ({'China': 'cn', 'China (excludes SARs and Taiwan)': 'cn', 'India': 'in', 'Nepal': 'np', 'Malaysia': 'my', 'Vietnam': 'vn', 'Viet Nam': 'vn', 'Singapore': 'sg', 'Indonesia': 'id', 'Hong Kong': 'hk', 'Hong Kong (SAR)': 'hk', 'Hong Kong (SAR of China)': 'hk', 'Hong Kong, China': 'hk', 'Sri Lanka': 'lk', 'Philippines': 'ph', 'Pakistan': 'pk', 'Bangladesh': 'bd', 'Thailand': 'th', 'Taiwan': 'tw', 'South Korea': 'kr', 'Korea': 'kr', 'Korea, Republic of': 'kr', 'Japan': 'jp', 'United States': 'us', 'United States of America': 'us', 'USA': 'us', 'United Kingdom': 'gb', 'UK': 'gb', 'Canada': 'ca', 'Germany': 'de', 'France': 'fr', 'Iran': 'ir', 'Iran (Islamic Republic of)': 'ir', 'Saudi Arabia': 'sa', 'Brazil': 'br', 'Colombia': 'co', 'Nigeria': 'ng', 'Kenya': 'ke', 'Myanmar': 'mm'}[datum.Country] || 'un')",
      "as": "country_code"
    },
    {
      "calculate": "'https://hatscripts.github.io/circle-flags/flags/' + datum.country_code + '.svg'",
      "as": "circular_flag_url"
    }
  ],
  "layer": [
    {
      "description": "Horizontal median salary reference line ($70,000)",
      "data": {"values": [{"Salary": 70000}]},
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "stroke": "#C7D8D1",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {"field": "Salary", "type": "quantitative"}
      }
    },
    {
      "description": "Vertical median employment reference line (52%)",
      "data": {"values": [{"Full_time_employment": 52.0}]},
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "stroke": "#C7D8D1",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "Full_time_employment", "type": "quantitative"}
      }
    },
    {
      "description": "Quadrant annotation: High Salary, High Employment",
      "data": {"values": [{"x": 62, "y": 74500, "text": ""}]},
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontStyle": "italic",
        "fill": "#367C78"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "description": "Circular flag marks as scatter points",
      "mark": {
        "type": "image",
        "width": 12,
        "height": 12,
        "cursor": "pointer"
      },
      "params": [
        {
          "name": "hover_country",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout",
            "fields": ["Country"]
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "Full_time_employment",
          "type": "quantitative",
          "title": "Full-Time Employment Rate (%)",
          "scale": {"domain": [35, 68]},
          "axis": {
            "format": ".0f",
            "grid": true,
            "gridColor": "#f1f5f9",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "Salary",
          "type": "quantitative",
          "title": "Median Full-Time Annual Salary ($AUD)",
          "scale": {"domain": [60000, 76000]},
          "axis": {
            "format": "$,d",
            "grid": true,
            "gridColor": "#f1f5f9",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "url": {"field": "circular_flag_url", "type": "nominal"},
        "opacity": {
          "condition": {
            "param": "hover_country",
            "empty": false,
            "value": 1.0
          },
          "value": 0.85
        },
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Home Country"},
          {"field": "Full_time_employment", "type": "quantitative", "title": "Full-Time Employment Rate", "format": ".1f"},
          {"field": "Salary", "type": "quantitative", "title": "Median Starting Salary", "format": "$,d"},
          {"field": "Overall_employment", "type": "quantitative", "title": "Overall Employment Rate", "format": ".1f"},
          {"field": "Labour_force_participation", "type": "quantitative", "title": "Labour Force Participation", "format": ".1f"},
          {"field": "Under_30", "type": "quantitative", "title": "Aged ≤ 30 Years (%)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  }
}
