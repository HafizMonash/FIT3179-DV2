{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 850,
  "height": 480,
  "projection": {
    "type": "equalEarth",
    "rotate": [-150, 0, 0]
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {
        "type": "geoshape",
        "fill": "#F4F1E9",
        "stroke": "#C7D8D1",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {"graticule": true},
      "mark": {
        "type": "geoshape",
        "stroke": "#C7D8D1",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega-datasets/next/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#C7D8D1",
        "stroke": "#ffffff",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/international_students_flow.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Total_students": "number",
            "Continuing_students": "number",
            "New_students": "number",
            "Percent_new": "number",
            "origin_lat": "number",
            "origin_lon": "number",
            "dest_lat": "number",
            "dest_lon": "number"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeCap": "round"
          },
          "encoding": {
            "longitude": {"field": "origin_lon", "type": "quantitative"},
            "latitude": {"field": "origin_lat", "type": "quantitative"},
            "longitude2": {"field": "dest_lon"},
            "latitude2": {"field": "dest_lat"},
            "strokeWidth": {
              "field": "Total_students",
              "type": "quantitative",
              "scale": {"domain": [4000, 180000], "range": [1.5, 7.5]},
              "legend": {"title": "Flow Volume", "format": ",d"}
            },
            "color": {
              "field": "Continent",
              "type": "nominal",
              "scale": {
                "domain": ["Asia", "South America", "Europe", "North America", "Africa"],
                "range": ["#2563eb", "#ea580c", "#059669", "#7c3aed", "#db2777"]

              },
              "legend": {
                "title": "Continent",
                "offset": 8,
                "symbolType": "stroke"
              }
            },
            "opacity": {
              "condition": {"param": "highlight", "empty": false, "value": 1.0},
              "value": 0.35
            },
            "tooltip": [
              {"field": "Country", "type": "nominal", "title": "Source Country"},
              {"field": "Continent", "type": "nominal", "title": "Continent"},
              {"field": "Total_students", "type": "quantitative", "title": "Total Students", "format": ",d"},
              {"field": "Continuing_students", "type": "quantitative", "title": "Continuing Students", "format": ",d"},
              {"field": "New_students", "type": "quantitative", "title": "New Commencements", "format": ",d"},
              {"field": "Percent_new", "type": "quantitative", "title": "New Students (%)", "format": ".1f"}
            ]
          }
        },
        {
          "mark": {
            "type": "circle",
            "stroke": "#ffffff",
            "strokeWidth": 1.2,
            "cursor": "pointer"
          },
          "params": [
            {
              "name": "highlight",
              "select": {
                "type": "point",
                "on": "pointerover",
                "clear": "pointerout",
                "fields": ["Country"]
              }
            }
          ],
          "encoding": {
            "longitude": {"field": "origin_lon", "type": "quantitative"},
            "latitude": {"field": "origin_lat", "type": "quantitative"},
            "size": {
              "field": "Total_students",
              "type": "quantitative",
              "scale": {"domain": [4000, 180000], "range": [40, 500]},
              "legend": null
            },
            "color": {
              "field": "Continent",
              "type": "nominal",
              "scale": {
                "domain": ["Asia", "South America", "Europe", "North America", "Africa"],
                "range": ["#367C78", "#D98C62", "#172B3A", "#8AA9A2", "#B96F4A"]
              }
            },
            "opacity": {
              "condition": {"param": "highlight", "empty": false, "value": 1.0},
              "value": 0.85
            },
            "tooltip": [
              {"field": "Country", "type": "nominal", "title": "Source Country"},
              {"field": "Continent", "type": "nominal", "title": "Continent"},
              {"field": "Total_students", "type": "quantitative", "title": "Total Students", "format": ",d"},
              {"field": "Continuing_students", "type": "quantitative", "title": "Continuing Students", "format": ",d"},
              {"field": "New_students", "type": "quantitative", "title": "New Commencements", "format": ",d"},
              {"field": "Percent_new", "type": "quantitative", "title": "New Students (%)", "format": ".1f"}
            ]
          }
        },
        {
          "transform": [
            {"filter": "datum.Total_students >= 60000"}
          ],
          "mark": {
            "type": "text",
            "dx": 0,
            "dy": -13,
            "fontSize": 10.5,
            "fontWeight": "bold",
            "fill": "#172B3A"
          },
          "encoding": {
            "longitude": {"field": "origin_lon", "type": "quantitative"},
            "latitude": {"field": "origin_lat", "type": "quantitative"},
            "text": {"field": "Country", "type": "nominal"}
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {"name": "Australia", "lat": -35.28, "lon": 149.13}
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 180,
            "color": "#000000",
            "stroke": "#ffffff",
            "strokeWidth": 2
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "tooltip": [{"field": "name", "type": "nominal", "title": "Destination"}]
          }
        },
        {
          "mark": {
            "type": "text",
            "text": "Australia (Destination)",
            "dx": 12,
            "dy": 15,
            "fontSize": 11,
            "fontWeight": "bold",
            "fill": "#000000"
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"}
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  }
}
