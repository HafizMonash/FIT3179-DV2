{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 560,
  "data": {
    "url": "data/undergraduate_employment_by_study_area.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "string",
        "Full_time_employment": "number",
        "Overall_employment": "number",
        "Labour_force_participation": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Survey Year",
      "axis": {
        "orient": "top",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "titleFontSize": 12,
        "domain": false,
        "ticks": false
      },
      "scale": {"padding": 0.05}
    },
    "y": {
      "field": "Study_area",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "Full_time_employment",
        "op": "mean",
        "order": "descending"
      },
      "axis": {
        "labelFontSize": 11,
        "labelLimit": 320,
        "domain": false,
        "ticks": false
      },
      "scale": {"padding": 0.05}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 3,
        "cursor": "pointer"
      },
      "params": [
        {
          "name": "hover_cell",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "encoding": {
        "color": {
          "field": "Full_time_employment",
          "type": "quantitative",
          "scale": {
            "range": ["#F4F1E9", "#367C78"],
            "domain": [30, 100],
            "nullValue": "#C7D8D1"
          },
          "legend": {
            "title": "Full-Time Employed (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "titleFontSize": 11,
            "labelFontSize": 11,
            "offset": 12
          }
        },
        "stroke": {
          "condition": {
            "param": "hover_cell",
            "empty": false,
            "value": "#0f172a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover_cell",
            "empty": false,
            "value": 2
          },
          "value": 1
        },
        "tooltip": [
          {"field": "Study_area", "type": "nominal", "title": "Study Area"},
          {"field": "Year", "type": "ordinal", "title": "Survey Year"},
          {
            "field": "Full_time_employment",
            "type": "quantitative",
            "title": "Full-Time Employment",
            "format": ".1f"
          },
          {
            "field": "Overall_employment",
            "type": "quantitative",
            "title": "Overall Employment",
            "format": ".1f"
          },
          {
            "field": "Labour_force_participation",
            "type": "quantitative",
            "title": "Labour Force Participation",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 500
      },
      "encoding": {
        "text": {
          "calculate": "datum.Full_time_employment != null ? format(datum.Full_time_employment, '.1f') + '%' : 'N/A'"
        },
        "color": {
          "condition": [
            {
              "test": "datum.Full_time_employment != null && datum.Full_time_employment >= 68",
              "value": "#ffffff"
            },
            {
              "test": "datum.Full_time_employment == null",
              "value": "#8AA9A2"
            }
          ],
          "value": "#0f172a"
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  }
}
